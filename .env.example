# Copy this file to `.env.local`, then run the app:
#   cp .env.example .env.local     (macOS/Linux)
#   copy .env.example .env.local   (Windows)
#
# Enables the seeded demo accounts (physician / pharmacy / admin / superadmin)
# so the app is usable without provisioning real accounts. This is a public
# build-time flag, not a secret. Remove it for a real production deployment.
NEXT_PUBLIC_ENABLE_DEV_ACCOUNTS=true
