# Copy this file to `.env.local`, then run the app:
#   cp .env.example .env.local     (macOS/Linux)
#   copy .env.example .env.local   (Windows)
#
# Enables the seeded demo accounts (physician / pharmacy / admin / superadmin)
# so the app is usable without provisioning real accounts. This is a public
# build-time flag, not a secret. Remove it for a real production deployment.
NEXT_PUBLIC_ENABLE_DEV_ACCOUNTS=true

# --- Supabase (Phase 1: Auth + Accounts + Access Requests) ---
# Find these in the Supabase Dashboard: Project Settings -> API.

# Safe to expose to the browser — access is governed by Row Level Security,
# not by keeping this value secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only. Bypasses Row Level Security entirely. Never prefix
# with NEXT_PUBLIC_, never commit a real value, never let it reach the
# browser bundle. Used only by app/api/admin/access-requests/[id]/approve
# and scripts/seed-supabase.ts. In Vercel, add this as a server-side
# environment variable (the default scope) — not one exposed to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The app's own public URL, used to build the invite-email redirect link
# (…/activate) sent by app/api/admin/access-requests/[id]/approve. Must
# exactly match an entry in Supabase Auth -> URL Configuration -> Redirect
# URLs, or activation links will fail. Set to your real Vercel URL in
# production; localhost is fine for local dev.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email delivery (Send Email Hook, bypasses Supabase's built-in SMTP) ---
# Supabase's own email sender is rate-limited, and this project's outbound
# SMTP to a custom provider timed out — see app/api/auth/send-email-hook.
# Configure in Supabase Dashboard -> Authentication -> Hooks -> "Send Email
# hook" -> HTTPS -> this route's deployed URL -> Generate Secret.

# SECRET — server-only. From Supabase Dashboard -> Authentication -> Hooks,
# formatted "v1,whsec_...". Verifies incoming hook calls are really from
# Supabase, not a forged request.
SEND_EMAIL_HOOK_SECRET=v1,whsec_your-hook-secret

# SECRET — server-only. From the Resend dashboard -> API Keys.
RESEND_API_KEY=re_your-resend-api-key

# OPTIONAL — server-only. Sender address used for invite/auth emails, e.g.
# "MediGuard <noreply@yourdomain>". Falls back to Resend's shared sandbox
# sender ("MediGuard <onboarding@resend.dev>") if unset, which can only
# deliver to the Resend account's own verified email address. Requires a
# domain verified at resend.com/domains before real recipients can be sent
# to (see app/api/auth/send-email-hook).
# RESEND_FROM_ADDRESS=MediGuard <noreply@yourdomain>

# --- Patient Self-Check monetization (Phase 3: 3 free checks per phone, ---
# --- then pay-as-you-go via Paystack Mobile Money) ---

# SECRET — server-only. From the Paystack dashboard -> Settings -> API Keys
# & Webhooks. Used to call the charge API and to verify incoming webhook
# signatures (app/api/payments/paystack-webhook).
PAYSTACK_SECRET_KEY=sk_test_your-paystack-secret-key

# Price of one pay-as-you-go check, in pesewas (100 = GHS 1.00). This is a
# business default, not a fixed constraint — change it freely. Public/
# NEXT_PUBLIC_-prefixed because the price is shown to the patient before
# they pay.
NEXT_PUBLIC_CHECK_PRICE_PESEWAS=200

# SECRET — server-only. From account.africastalking.com -> Settings ->
# API Key. Used to send OTP codes via Africa's Talking's SMS API
# (app/api/otp/send) — chosen over Twilio for direct MTN/Vodafone/
# AirtelTigo Ghana routing and Mobile-Money-fundable billing. Africa's
# Talking has no Verify-equivalent service, so code generation, expiry, and
# attempt-limiting live in this app itself (app/api/otp/send,
# app/api/otp/verify, 0023_self_hosted_otp_codes.sql), not the provider.
AFRICASTALKING_API_KEY=your-africastalking-api-key

# Your Africa's Talking account username. Use the literal value "sandbox"
# to route to their free, no-real-delivery sandbox environment during
# development — this is Africa's Talking's own convention, not a separate
# flag.
AFRICASTALKING_USERNAME=sandbox

# --- Physician/Pharmacy Portal subscriptions (Phase C: self-serve signup, ---
# --- active-until-period_end via Paystack Mobile Money) ---
# Reuses PAYSTACK_SECRET_KEY above — no separate key needed.

# Monthly price per portal, in pesewas (100 = GHS 1.00). Business defaults,
# not fixed constraints — change freely. NEXT_PUBLIC_-prefixed because the
# price is shown on /billing before the subscriber pays.
NEXT_PUBLIC_PHYSICIAN_PORTAL_PRICE_PESEWAS=15000
NEXT_PUBLIC_PHARMACY_PORTAL_PRICE_PESEWAS=15000
